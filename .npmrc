# Pin THIS repository's npm operations to the official registry. The maintainer
# machine's user-level .npmrc points at a read-only mirror (npmmirror), and one
# local `npm install` once wrote a mirror URL into package-lock.json's
# `resolved` field — harmless to older npm, fatal to npm >= 12 (EALLOWREMOTE
# refuses remote-type entries). A project-level .npmrc wins over the user one,
# so lockfile updates inside this repo always record official URLs.
# Not part of the npm tarball (`files` in package.json does not list it).
registry=https://registry.npmjs.org
